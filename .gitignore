# GPLv3 external dependencies — installed locally by scripts/setup_otilib.sh,
# NEVER vendored or committed into this framework (which is not GPL).
external/gpl/
third_party/gpl/

# generated user-run outputs and python caches
resasm_output/
__pycache__/
*.pyc

# python build artifacts
*.egg-info/
build/
dist/
.eggs/

# stray local logs
abq_val_log.txt

# Build products from the Fortran material adapters
*.o
*.mod
*.so

# Scratch workspace written by the optional Streamlit GUI (residual_core/app).
resasm_gui_workspace/

# presentation-claim reproductions: run-time results (small JSON/CSV) are regenerated;
# only verification/expected/ is committed
verification/results/
