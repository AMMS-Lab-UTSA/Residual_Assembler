# transform build workspaces / intermediates (regenerated by the transformer)
oti_provider/materials/*/build/
oti_provider/materials/*/out/
umat_oti_workspace/
oti_results/
# platform-specific build OUTPUTS (regenerated by `umat_transform.py build`):
# the compiled object is a per-platform binary and the completed contract embeds
# its per-platform hash + binary metadata, so neither is committed.
oti_provider/materials/*/umat_*_oti.obj
oti_provider/materials/*/umat_*_oti.json
oti_provider/materials/*/material.resmat.zip
oti_provider/elastic/dist/
# reference provider build output
oti_provider/elastic/*.o
